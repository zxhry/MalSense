# Copy to .env for local testing. On Render, add these under Environment instead (never commit real values).
FLASK_SECRET_KEY=change-me-to-a-long-random-string
# Private testing: visitors must enter this code on the splash screen (leave empty to open the site to all)

# --- Database: TiDB Cloud (from the cluster's "Connect" dialog) ---
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_USER=xxxxxxxx.root
DB_PASSWORD=
DB_NAME=malsense
DB_SSL=true

# --- APIs ---
VT_API_KEY=
QUIZ_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (Render blocks SMTP, so use gmail_api online) ---
MAIL_PROVIDER=gmail_api
MAIL_USERNAME=your-gmail@gmail.com
GMAIL_REFRESH_TOKEN=
FEEDBACK_TO=
